{
  "features": {
    "introspection": {
      "label": "Introspection",
      "riskWhen": "enabled",
      "risk": "Full schema disclosure through introspection queries."
    },
    "fieldSuggestions": {
      "label": "Field Suggestions",
      "riskWhen": "enabled",
      "risk": "\"Did you mean ...\" errors leak the schema even when introspection is disabled."
    },
    "debugMode": {
      "label": "Debug Mode",
      "riskWhen": "enabled",
      "risk": "Stack traces and internal details leak through error responses."
    },
    "batchRequests": {
      "label": "Batch Requests",
      "riskWhen": "enabled",
      "risk": "Many operations per HTTP request can bypass rate limiting and brute-force protections."
    },
    "persistedQueries": {
      "label": "Automatic Persisted Queries",
      "riskWhen": "enabled",
      "risk": "Operations can be registered and replayed by hash, including over GET (CSRF, cache abuse)."
    },
    "depthLimit": {
      "label": "Query Depth Limit",
      "riskWhen": "absent",
      "risk": "Deeply nested or circular queries are allowed."
    },
    "costAnalysis": {
      "label": "Query Cost Analysis",
      "riskWhen": "absent",
      "risk": "Expensive queries are not rejected."
    }
  },
